NET "clk"     LOC = "L15" | IOSTANDARD = LVCMOS33;
NET "rx_line" LOC = "A16" | IOSTANDARD = LVCMOS33;
NET "tx_line" LOC = "B16" | IOSTANDARD = LVCMOS33;

# Change "led" to "leds" and use the board-specific pin locations
NET "led<0>" LOC = "U18" | IOSTANDARD = LVCMOS33;
NET "led<1>" LOC = "M14" | IOSTANDARD = LVCMOS33;
NET "led<2>" LOC = "N14" | IOSTANDARD = LVCMOS33;
NET "led<3>" LOC = "L14" | IOSTANDARD = LVCMOS33;
NET "led<4>" LOC = "M13" | IOSTANDARD = LVCMOS33;
NET "led<5>" LOC = "D4"  | IOSTANDARD = LVCMOS33;
NET "led<6>" LOC = "P16" | IOSTANDARD = LVCMOS33;
NET "led<7>" LOC = "N12" | IOSTANDARD = LVCMOS33;


NET "btn[0]" LOC = A10  | IOSTANDARD = LVCMOS33;  # IO_L31P_GCLK31_2
NET "btn[1]" LOC = D14  | IOSTANDARD = LVCMOS33;  # IO_L31N_GCLK30_2
NET "btn[2]" LOC = C14  | IOSTANDARD = LVCMOS33;  # IO_L32P_GCLK29_2
NET "btn[3]" LOC = P15  | IOSTANDARD = LVCMOS33;  # IO_L32N_GCLK28_2