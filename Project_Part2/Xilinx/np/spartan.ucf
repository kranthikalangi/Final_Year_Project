########################################
# CLOCK INPUT
########################################
NET "clk" LOC = L15 | IOSTANDARD = LVCMOS33;  # IO_L30N_GCLK0_USERCCLK_2

########################################
# SWITCHES (8)
########################################
NET "sw[0]" LOC = A10  | IOSTANDARD = LVCMOS33;  # IO_L31P_GCLK31_2
NET "sw[1]" LOC = D14  | IOSTANDARD = LVCMOS33;  # IO_L31N_GCLK30_2
NET "sw[2]" LOC = C14  | IOSTANDARD = LVCMOS33;  # IO_L32P_GCLK29_2
NET "sw[3]" LOC = P15  | IOSTANDARD = LVCMOS33;  # IO_L32N_GCLK28_2
NET "sw[4]" LOC = P12  | IOSTANDARD = LVCMOS33;  # IO_L40P_2
NET "sw[5]" LOC = R5   | IOSTANDARD = LVCMOS33;  # IO_L40N_2
//NET "sw[6]" LOC = T5   | IOSTANDARD = LVCMOS33;  # IO_L41P_2
//NET "sw[7]" LOC = E4   | IOSTANDARD = LVCMOS33;  # IO_L41N_VREF_2

########################################
# PUSH BUTTONS (5)
########################################
NET "btn[0]" LOC = P4 | IOSTANDARD = LVCMOS33;  # IO_L43P_2
NET "btn[1]" LOC = P3 | IOSTANDARD = LVCMOS33;  # IO_L43N_2
NET "btn[2]" LOC = F6 | IOSTANDARD = LVCMOS33;  # IO_L44P_2
NET "btn[3]" LOC = N4 | IOSTANDARD = LVCMOS33;  # IO_L44N_2
NET "btn[4]" LOC = F5 | IOSTANDARD = LVCMOS33;  # IO_L45P_2

########################################
# LED OUTPUTS (8)
########################################
NET "led[0]" LOC = U18 | IOSTANDARD = LVCMOS33;  # IO_L45N_2
NET "led[1]" LOC = M14 | IOSTANDARD = LVCMOS33;  # IO_L46P_2
NET "led[2]" LOC = N14 | IOSTANDARD = LVCMOS33;  # IO_L46N_2
NET "led[3]" LOC = L14 | IOSTANDARD = LVCMOS33;  # IO_L47P_2
NET "led[4]" LOC = M13 | IOSTANDARD = LVCMOS33;  # IO_L47N_2
NET "led[5]" LOC = D4  | IOSTANDARD = LVCMOS33;  # IO_L48P_D7_2
NET "led[6]" LOC = P16 | IOSTANDARD = LVCMOS33;  # IO_L48N_RDWR_B_2
NET "led[7]" LOC = N12 | IOSTANDARD = LVCMOS33;  # IO_L49P_D3_2
